participant A participant "A"
participant B participant "B"
participant C participant "C"
block loop "Every minute"
  message A B solid arrow "ping"
  block alt "ok"
    message B A solid arrow "pong"
    section "failed"
    message B A solid arrow "error"
block opt "maybe"
  message A B solid arrow "x"
block par "one"
  message A B solid arrow "a"
  section "two"
  message A C solid arrow "b"
block critical "connect"
  message A B solid arrow "try"
  section "timeout"
  message A B solid arrow "retry"
block break "stop"
  message A B solid arrow "halt"
block rect "rgb(0, 255, 0)"
  message A B solid arrow "boxed"
